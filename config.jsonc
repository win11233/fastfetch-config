{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
        {
            "type": "title",
            "format": "PC ➜ {user-name}@{host-name}"
        },
        "separator",
        
        // --- System ---
        { "type": "os", "key": " ├─ 󰣇 OS      " },
        { "type": "kernel", "key": " ├─  Kernel  " },
        { "type": "uptime", "key": " └─ 󰅐 Uptime  " },
        
        // --- Environment ---
        "break",
        { "type": "wm", "key": " ├─  WM      " },
        { "type": "theme", "key": " ├─  Theme   " },
        { "type": "icons", "key": " ├─ 󰀻 Icons   " },
        { "type": "font", "key": " └─  Font    " },
        
        // --- Hardware & Stats ---
        "break",
        { "type": "cpu", "key": " ├─  CPU     " },
        { "type": "gpu", "key": " ├─ 󰘚 GPU     " },
        { "type": "memory", "key": " ├─  Mem     " },
        { "type": "loadavg", "key": " ├─ 󰻠 Load    " },
        { "type": "disk", "key": " └─ 󰋊 Disk    " },
        
        // --- Connectivity ---
        "break",
        { "type": "localip", "key": " ├─ 󰩟 IP      " },
        { "type": "battery", "key": " └─ 󱊣 Bat     " },
        
        "break",
        "colors"
    ]
}